# --- ClickHouse & Storage Config ---
CHVER=latest

# --- Airflow Core Config ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=your_secure_airflow_password
AIRFLOW__API_AUTH__JWT_SECRET=your_secure_jwt_secret
FERNET_KEY=your_base64_fernet_key

# --- Database Credentials (Postgres for Airflow) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=airflow

# --- MinIO Credentials ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=your_secure_minio_password

# --- ClickHouse Credentials ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_secure_clickhouse_password
